# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# These are used by the server-side pipeline from Phase 1/2 onwards.

# OpenRouter: AI rewrites, blog drafts, fighter enrichment
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2

# API-Sports MMA: fight cards and results (optional)
API_SPORTS_KEY=

# Supabase: shared database, auth and scheduled jobs
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Places: gym finder (optional, Phase 4)
GOOGLE_PLACES_API_KEY=
